generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
  TENANT
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum AssignmentStatus {
  ACTIVE
  ENDED
}

enum RentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ExpenseCategory {
  ELECTRICITY
  WATER
  INTERNET
  FOOD
  MAINTENANCE
  CLEANING
  SALARY
  OTHER
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ComplaintStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  ownerId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  properties Property[]
  tenants    Tenant[]
  expenses   Expense[]
}

model User {
  id             String        @id @default(uuid())
  name           String
  email          String        @unique
  passwordHash   String
  role           UserRole      @default(STAFF)
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([email])
}

model Property {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  address        String
  city           String
  state          String
  pincode        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  floors       Floor[]
  complaints   Complaint[]

  @@index([organizationId])
}

model Floor {
  id         String   @id @default(uuid())
  propertyId String
  name       String
  floorNumber Int

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rooms    Room[]

  @@index([propertyId])
}

model Room {
  id         String @id @default(uuid())
  floorId    String
  roomNumber String
  capacity   Int

  floor Floor @relation(fields: [floorId], references: [id], onDelete: Cascade)
  beds  Bed[]

  @@index([floorId])
}

model Bed {
  id          String    @id @default(uuid())
  roomId      String
  bedNumber   String
  status      BedStatus @default(AVAILABLE)
  monthlyRent Decimal   @default(0) @db.Decimal(10, 2)

  room        Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignments BedAssignment[]

  @@index([roomId])
  @@index([status])
}

model Tenant {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  phone          String
  email          String?
  joiningDate    DateTime @default(now())
  deposit        Decimal  @default(0) @db.Decimal(10, 2)
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  assignments  BedAssignment[]
  rents        Rent[]
  complaints   Complaint[]

  @@index([organizationId])
  @@index([phone])
}

model BedAssignment {
  id         String           @id @default(uuid())
  tenantId   String
  bedId      String
  startDate  DateTime         @default(now())
  endDate    DateTime?
  rent       Decimal          @db.Decimal(10, 2)
  status     AssignmentStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  bed      Bed      @relation(fields: [bedId], references: [id])
  rents    Rent[]

  @@index([tenantId])
  @@index([bedId])
  @@index([status])
}

model Rent {
  id           String     @id @default(uuid())
  tenantId     String
  assignmentId String
  amount       Decimal    @db.Decimal(10, 2)
  dueDate      DateTime
  paidAmount   Decimal    @default(0) @db.Decimal(10, 2)
  status       RentStatus @default(PENDING)
  month        Int
  year         Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  assignment BedAssignment @relation(fields: [assignmentId], references: [id])
  payments Payment[]

  @@unique([tenantId, month, year])
  @@index([tenantId])
  @@index([status])
  @@index([month, year])
}

model Payment {
  id        String        @id @default(uuid())
  rentId    String
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  reference String?
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime      @default(now())

  rent Rent @relation(fields: [rentId], references: [id], onDelete: Cascade)

  @@index([rentId])
}

model Expense {
  id             String          @id @default(uuid())
  organizationId String
  category       ExpenseCategory
  amount         Decimal         @db.Decimal(10, 2)
  date           DateTime
  description    String?
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([date])
  @@index([category])
}

model Complaint {
  id             String            @id @default(uuid())
  tenantId       String
  propertyId     String
  roomId         String?
  category       String
  title          String
  description    String
  priority       ComplaintPriority @default(MEDIUM)
  status         ComplaintStatus   @default(OPEN)
  assignedTo     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
  @@index([priority])
}
